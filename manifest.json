{
  "name": "SLink - Simple copy link",
  "description": "Copy page link and title to clipboard, so simple!",
  "version": "1.0.3",
  "icons": {
    "48": "img/icon.png",
    "96": "img/icon@2x.png"
  },
  "action": {
    "default_icon": {
      "19": "img/icon-19.png",
      "38": "img/icon-38.png"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "commands": {
    "copy_as_markdown": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "Copy Tab Title / Tab URL as Markdown"
    },
    "copy_as_plaintext": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Copy Tab Title / Tab URL as Plaintext"
    }
  },
  "manifest_version": 3
}
